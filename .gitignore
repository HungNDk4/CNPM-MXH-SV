# ============================================================
# .gitignore cho Mini Study Network
# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs
dist/
build/
.next/

# Logs
logs/
*.log
npm-debug.log*

# Runtime
pids/
*.pid

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS
.DS_Store
Thumbs.db

# Uploads (lưu ngoài git)
server/uploads/*
!server/uploads/.gitkeep

# Private PDF objects (never commit document bytes)
server/private-documents/

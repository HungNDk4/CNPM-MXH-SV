# ==============================
# SERVER ENVIRONMENT VARIABLES
# ==============================

# App
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mini_study_network
DB_USER=root
DB_PASSWORD=your_mysql_password

# JWT
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production_64chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_64chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# VNPay Sandbox
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/payment/vnpay-return
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Upload (local hoặc cloud)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# Development safety: do not auto-alter imported SQL schema on Ubuntu.
# Existing dev behavior is to sync({ alter: true }) unless explicitly disabled.
DB_AUTO_SYNC=false
# Business upload maximum is 10 MiB/1 PDF, but binary PDF upload is NOT implemented yet.

# DEP-01C: production cloud preview only. These examples are NOT real secrets.
SERVE_CLIENT_DIST=false
# TiDB Cloud Starter public connection must verify TLS certificate.
TIDB_CLOUD=false
TIDB_ENABLE_SSL=false
DB_SSL_MODE=disable
# Optional trusted CA file (Node built-in CA works for TiDB Starter):
# TIDB_CA_PATH=/etc/ssl/certs/ca-certificates.crt
# Local CI and development remain on filesystem by default.
DOCUMENT_STORAGE_DRIVER=filesystem
# For actual private Vercel Blob set in Render server-only secret manager:
# BLOB_READ_WRITE_TOKEN=<never commit>
